{
  "name": "ai360-copilot",
  "displayName": "AI360 Agentic Copilot & FinOps Workspace",
  "description": "Claude Code style AI assistant with intelligent workspace coding, Prompt Optimization, FinOps telemetry, and real-time token tracking.",
  "version": "1.0.0",
  "publisher": "AI360",
  "icon": "resources/logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onView:ai360.chatView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai360.login",
        "title": "AI360: Login Employee"
      },
      {
        "command": "ai360.optimizeSelection",
        "title": "AI360: Optimize Selected Prompt"
      },
      {
        "command": "ai360.explainCode",
        "title": "AI360: Explain Selected Code"
      },
      {
        "command": "ai360.refactorCode",
        "title": "AI360: Refactor Selected Code"
      },
      {
        "command": "ai360.showStats",
        "title": "AI360: Show Today's AI Usage & Tokens"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ai360.explainCode",
          "group": "ai360@1"
        },
        {
          "command": "ai360.refactorCode",
          "group": "ai360@2"
        },
        {
          "command": "ai360.optimizeSelection",
          "group": "ai360@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai360-sidebar",
          "title": "AI360 Agent",
          "icon": "resources/logo.png"
        }
      ]
    },
    "views": {
      "ai360-sidebar": [
        {
          "type": "webview",
          "id": "ai360.chatView",
          "name": "AI360 Copilot & Agent"
        }
      ]
    },
    "configuration": {
      "title": "AI360 Agent",
      "properties": {
        "ai360.backendUrl": {
          "type": "string",
          "default": "https://ai-360-dashboard.vercel.app/",
          "description": "URL of the AI360 backend service."
        },
        "ai360.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Gemini API Key for direct AI capability."
        },
        "ai360.defaultModel": {
          "type": "string",
          "enum": [
            "claude-3-5-sonnet-20241022",
            "gemini-3.5-pro",
            "gemini-3.5-flash",
            "gpt-4o",
            "gpt-4o-mini"
          ],
          "default": "claude-3-5-sonnet-20241022",
          "description": "Default AI model for code assistance and chat."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "compile": "npm run esbuild-base -- --sourcemap",
    "watch": "npm run esbuild-base -- --sourcemap --watch",
    "esbuild-base": "node esbuild.js"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.19.11",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/marked": "^5.0.2",
    "axios": "^1.6.5",
    "firebase": "^10.7.1",
    "marked": "^11.1.1"
  }
}
