# ──────────────────────────────────────────────────────────────────────────────
# AI360 Environment Variables – Copy to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# ─── Firebase (Client SDK – used by Dashboard & VS Code Extension) ─────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─── Firebase (Admin SDK – used by Backend only) ───────────────────────────────
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_long_random_secret_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── AI Provider API Keys ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...

# ─── Backend Server ────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Dashboard ─────────────────────────────────────────────────────────────────
VITE_BACKEND_URL=http://localhost:8000

# ─── VS Code Extension ─────────────────────────────────────────────────────────
EXTENSION_BACKEND_URL=http://localhost:8000

# ─── Email Notifications ───────────────────────────────────────────────────────
EMAIL_PROVIDER=resend          # Options: resend | sendgrid | smtp
EMAIL_API_KEY=your_email_api_key
EMAIL_FROM=noreply@your-domain.com

# ─── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development
PYTHON_ENV=development
LOG_LEVEL=INFO
